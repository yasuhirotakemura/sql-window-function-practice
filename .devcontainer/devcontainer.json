{
  "name": "DuckDB SQL Window Function Practice",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.encoding": "utf8"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
